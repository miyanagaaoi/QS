# 环境变量样例：复制为 .env 后修改（backend/.env）
# 生成密钥：openssl rand -hex 32

# --- 必改 ---
# JWT 签名密钥，生产必须替换
XUNJIA_SECRET_KEY=please-change-this-secret-in-production

# --- 数据库 ---
# SQLite（默认）：相对路径基于 backend/ 解析
XUNJIA_DATABASE_URL=sqlite:///./data/xunjia.db
# PostgreSQL 16（可选，需先 pip install "psycopg[binary]"）
# XUNJIA_DATABASE_URL=postgresql+psycopg://xunjia:xunjia@127.0.0.1:5432/xunjia

# --- 初始账号 ---
# 留空则首次启动生成随机密码并打印到日志（首次登录强制改密）
XUNJIA_ADMIN_PASSWORD=
XUNJIA_BUYER_PASSWORD=buyer123
XUNJIA_DEMO_PASSWORD=supplier123

# --- 演示数据 ---
# 1 = 首次启动写入 5 家供货商 + 3 张示例询价单（仅开发环境使用，生产保持 0）
XUNJIA_SEED_DEMO=1

# --- 其他 ---
XUNJIA_DEBUG=false
XUNJIA_UPLOAD_DIR=./data/uploads
# 测试时可调低（生产保持 12）
XUNJIA_BCRYPT_ROUNDS=12
